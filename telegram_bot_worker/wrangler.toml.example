name = "strike-count-bot"
main = "telegram_counter_worker.js"
compatibility_date = "2025-01-01"

# 이 값들은 비밀값이 아니므로 wrangler.toml에 넣어도 됩니다.
[vars]
GITHUB_OWNER = "YOUR_GITHUB_ID_OR_ORG"
GITHUB_REPO = "YOUR_REPOSITORY_NAME"
GITHUB_BRANCH = "main"
COUNT_FILE_PATH = "data/strike_count.json"
SITE_URL = "https://www.xn--5h5bv6v.com"
TELEGRAM_ADMIN_IDS = "YOUR_TELEGRAM_NUMERIC_ID"

# 아래 3개는 wrangler.toml에 직접 쓰지 말고 secret으로 넣으세요.
# npx wrangler secret put TELEGRAM_BOT_TOKEN
# npx wrangler secret put TELEGRAM_SECRET_TOKEN
# npx wrangler secret put GITHUB_TOKEN
